{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freellmapihub.com/api/v1/free-gpu.schema.json",
  "title": "Free LLM API Hub, Free GPU compute (/api/v1/free-gpu.json)",
  "description": "The Free GPU compute section, apart from the provider ranking: services that give free GPU time, each value with the sentence it rests on and the day it was read. Contract v1: fields are only added within v1, so consumers must ignore fields they do not know; a breaking change goes to /api/v2/. A value the provider's page did not state has state not_stated and is never filled in.",
  "type": "object",
  "required": ["dataset", "version", "generated", "schema", "count", "entries", "notes"],
  "properties": {
    "dataset": { "const": "free-llm-api-hub" },
    "version": { "type": "string", "description": "The dataset release version (SemVer), the same as in every other file of /api/v1/." },
    "generated": { "type": "string", "format": "date", "description": "The date of the last dataset change." },
    "license": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "docs": { "type": "string", "format": "uri" },
    "description": { "type": "string" },
    "schema": { "type": "string", "format": "uri", "description": "The URL of this schema." },
    "page": { "type": "string", "format": "uri", "description": "The public page that shows the same section." },
    "count": { "type": "integer", "minimum": 0, "description": "The number of entries. Not a count of providers: the section is not part of the provider dataset." },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "notes": { "type": "array", "items": { "$ref": "#/$defs/note" } }
  },
  "$defs": {
    "quote": {
      "type": "object",
      "required": ["text", "source", "read"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "description": "The sentence, as the provider's page words it." },
        "source": { "type": "string", "format": "uri", "description": "The provider's own page." },
        "read": { "type": "string", "format": "date", "description": "The day the page was read." }
      }
    },
    "claim": {
      "type": "object",
      "required": ["state", "quotes"],
      "properties": {
        "state": { "enum": ["stated", "not_stated"], "description": "stated needs at least one quotation; not_stated means the provider's page did not say it and may carry the sentences that do not settle it." },
        "quotes": { "type": "array", "items": { "$ref": "#/$defs/quote" } }
      }
    },
    "entry": {
      "type": "object",
      "required": ["slug", "name", "url", "kind", "claims"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Never the slug of a provider of the dataset." },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "kind": { "enum": ["notebook", "serverless-api"] },
        "claims": {
          "type": "object",
          "required": ["gpu_access", "quota", "credit_amount", "expires", "card_required"],
          "properties": {
            "gpu_access": { "$ref": "#/$defs/claim" },
            "quota": { "$ref": "#/$defs/claim" },
            "credit_amount": { "$ref": "#/$defs/claim" },
            "expires": { "$ref": "#/$defs/claim" },
            "card_required": { "$ref": "#/$defs/claim" }
          }
        }
      }
    },
    "note": {
      "type": "object",
      "required": ["subject", "text", "quotes"],
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "quotes": { "type": "array", "items": { "$ref": "#/$defs/quote" } }
      }
    }
  }
}
